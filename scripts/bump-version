#!/usr/bin/env python3
"""Set a plugin's version in both tool manifests and open a changelog entry.

Usage: scripts/bump-version <plugin> <major|minor|patch|X.Y.Z>
"""
import datetime
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip())
    plugin, target = sys.argv[1], sys.argv[2]
    plugin_dir = ROOT / "plugins" / plugin
    manifests = [plugin_dir / ".claude-plugin" / "plugin.json",
                 plugin_dir / ".codex-plugin" / "plugin.json"]

    versions = {json.loads(m.read_text())["version"] for m in manifests}
    if len(versions) != 1:
        sys.exit(f"Manifests disagree: {sorted(versions)}")
    current = versions.pop()
    new = next_version(current, target)

    for m in manifests:
        data = json.loads(m.read_text())
        data["version"] = new
        m.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")

    changelog = plugin_dir / "CHANGELOG.md"
    text = changelog.read_text()
    entry = f"## {new} ({datetime.date.today()})\n\n- \n\n"
    text = text.replace("\n## ", f"\n{entry}## ", 1) if "\n## " in text else text + "\n" + entry
    changelog.write_text(text)

    print(f"{plugin}: {current} -> {new}. Fill in {changelog.relative_to(ROOT)}.")


def next_version(current, target):
    if re.fullmatch(r"\d+\.\d+\.\d+", target):
        return target
    major, minor, patch = map(int, current.split("."))
    if target == "major":
        return f"{major + 1}.0.0"
    if target == "minor":
        return f"{major}.{minor + 1}.0"
    if target == "patch":
        return f"{major}.{minor}.{patch + 1}"
    sys.exit(f"Unknown version target: {target}")


if __name__ == "__main__":
    main()
